# =============================================================================
# Icebox Environment Variables Example
# Copy this file to .env and replace placeholder values with your actual config.
# =============================================================================

# Django Security & Core Settings
# In production, set DJANGO_DEBUG=False and specify a strong random secret key.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Allowed Hosts & CSRF Origins (comma-separated, no spaces)
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL / HTTPS Configuration (set to True when serving over HTTPS)
DJANGO_SECURE_SSL_REDIRECT=True

# SMTP Email Configuration (aiosmtplib)
# Required for sending temporary credentials to new incubatee/admin accounts.
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=your-email@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-app-password
DJANGO_DEFAULT_FROM_EMAIL=ICEBOX TBI <noreply@yourdomain.com>
